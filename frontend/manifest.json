{
  "manifest_version": 3,

  "name": "Chatbot IIS",

  "version": "1.0",

  "description": "Asistente académico UNSAAC",

  "permissions": [],

  "host_permissions": [
    "https://in.unsaac.edu.pe/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://in.unsaac.edu.pe/*"
      ],

      "js": [
        "content.js"
      ],

      "css": [
        "popup.css"
      ]
    }
  ]
}