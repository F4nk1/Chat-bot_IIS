{
  "manifest_version": 3,

  "name": "Chatbot IIS",

  "version": "1.0",

  "description": "Asistente académico UNSAAC",

  "icons": {
    "16": "assets/logo.svg",
    "48": "assets/logo.svg",
    "128": "assets/logo.svg"
  },

  "permissions": [],

  "host_permissions": [
    "https://in.unsaac.edu.pe/*"
  ],

  "action": {
    "default_popup": "pages/extension.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://in.unsaac.edu.pe/*"
      ],

      "js": [
        "js/content.js"
      ],

      "css": [
        "css/popup.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/DinoBot01.png",
        "assets/DinoBot02.png"
      ],
      "matches": [
        "https://in.unsaac.edu.pe/*"
      ]
    }
  ]
}