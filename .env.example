# Configuración del servidor
API_HOST=0.0.0.0
API_PORT=8000

# Configuración del modelo de IA (Gemini)
# ¡IMPORTANTE! Reemplaza 'TU_CLAVE_API_AQUI' con la clave real obtenida de Google AI Studio.
GEMINI_API_KEY=TU_CLAVE_API_AQUI

# Opcional: Puedes cambiar a gemini-3.6-pro si deseas mayor razonamiento
GEMINI_MODEL=gemini-3.6-flash
